{
  "name": "sweet-stack",
  "version": "1.0.0",
  "description": "A mobile-friendly 2D HTML5 cake stacking game",
  "main": "index.js",
  "scripts": {
    "start": "npm run build && node index.js",
    "build": "node --openssl-legacy-provider node_modules/webpack/bin/webpack.js --mode production --module-bind js=babel-loader",
    "verify:core": "node tools/verify-core-gameplay.js",
    "verify:release": "node tools/verify-web-release.js",
    "release:web": "npm run build && node tools/build-web-release.js",
    "release:offline": "npm run build && node tools/build-offline-single.js"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.0.0-beta.42",
    "@babel/preset-env": "^7.0.0-beta.42",
    "babel-loader": "^8.0.0-beta",
    "express": "^4.16.3",
    "opn": "^5.3.0",
    "webpack": "^4.0.1",
    "webpack-cli": "^3.1.1"
  },
  "dependencies": {
    "cooljs": "^1.0.2"
  }
}
